// Cloudflare Workers static assets (doc/plain/DevSecOps.md C6).
// `wrangler deploy` = prod at app.sokhin.site (main); `wrangler deploy --env dev` = dev-app.sokhin.site (dev).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modern-stock-webapp",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/modern_stock_webapp/browser",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "app.sokhin.site", "custom_domain": true }],
  "env": {
    "dev": {
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/modern_stock_webapp/browser",
        "not_found_handling": "single-page-application"
      },
      "routes": [{ "pattern": "dev-app.sokhin.site", "custom_domain": true }]
    }
  }
}
